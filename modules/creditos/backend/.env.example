# Copiar a .env y completar. NUNCA commitear .env con secretos reales.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://ccypp:ccypp@db:5432/ccypp

# Seguridad
JWT_SECRET=generar-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (origen del frontend)
CORS_ORIGINS=http://localhost:5173

# Integración API Intranet Catamarca (rotar credenciales del VFP)
INTRANET_AUTH_URL=https://api-intranet.catamarca.gob.ar/oauth2/token/
INTRANET_CLIENT_ID=
INTRANET_CLIENT_SECRET=
INTRANET_DATA_URL=https://api-intranet.catamarca.gob.ar/api/v1/public-employee/
